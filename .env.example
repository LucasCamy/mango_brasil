# Generate an isolated local configuration with: pnpm dev:env
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Override only when running Docker behind your HTTPS reverse proxy.
PUBLIC_WEB_ORIGIN=
POSTGRES_DB=totem
POSTGRES_USER=totem_owner
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=
RABBITMQ_USER=totem
RABBITMQ_PASSWORD=
RABBITMQ_URL=
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
BOOTSTRAP_EMAIL=owner@example.test
BOOTSTRAP_PASSWORD=
BOOTSTRAP_PIN=
TERMINAL_ID=TOTEM-01
TERMINAL_TOKEN=
PRINT_AGENT_TOKEN=
FISCAL_MODE=disabled
PAYMENT_MODE=simulated
ALLOW_DEMO_SEED=false
PRINT_TRANSPORT=spool
PRINT_TERMINAL_ID=CAIXA-01
PRINT_SPOOL_DIR=../../.local/print-spool
# Set PRINT_TRANSPORT=tcp and printer IP for physical ESC/POS printing.
PRINTER_HOST=
PRINTER_PORT=9100
BUSINESS_TIMEZONE=America/Cuiaba
