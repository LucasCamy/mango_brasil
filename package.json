{
  "name": "totem-pdv-central",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Totem Autoatendimento, PDV Central e Motor Fiscal NFC-e",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @totem-pdv/central-web test:e2e",
    "dev:env": "node scripts/setup-local.mjs",
    "dev:api": "pnpm --filter @totem-pdv/central-api dev",
    "dev:central": "pnpm --filter @totem-pdv/central-web dev",
    "worker": "pnpm --filter @totem-pdv/central-api worker",
    "print-agent": "pnpm --filter @totem-pdv/central-api print-agent",
    "db:migrate": "pnpm --filter @totem-pdv/central-api db:migrate",
    "db:status": "pnpm --filter @totem-pdv/central-api db:status",
    "db:seed": "pnpm --filter @totem-pdv/central-api db:seed",
    "api:openapi": "pnpm --filter @totem-pdv/central-api api:openapi"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@types/node": "^22.19.0"
  }
}
